# E时代 ID 环境变量示例（本地开发）
# macOS / Linux: cp .env.example .env
# Windows CMD:   copy .env.example .env
# 编辑 .env 中的占位值；项目会自动加载 .env，已设置的系统环境变量优先。
# 布尔值使用 true / false，多项配置使用英文逗号分隔。
# 密码包含空格或 # 时请用单引号包裹；不要提交填写了真实凭据的 .env。

# Django 基础配置
# 必填：生成独立密钥后替换占位值，可运行：
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
# 仅本地开发启用；上线时必须改为 false。
DJANGO_DEBUG=true
# 只填写域名 / IP，不包含协议、端口或路径。
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL（必填）：先创建数据库和账号，并授予该账号访问数据库的权限。
# 示例使用本机 MySQL；密码需与实际数据库账号一致。
DB_NAME=eid_db
DB_USER=eid_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=3306

# OAuth 登录
# 填写统一账号服务和用户信息 API 的根地址，不带末尾 /。
OAUTH2_SERVER_URL=https://account.example.com
OAUTH2_API_URL=https://accountapi.example.com
# 启动时要求非空；占位值仅供配置示例，实际登录需使用服务端分配的凭据。
OAUTH2_CLIENT_ID=change_me
OAUTH2_CLIENT_SECRET=change_me
# 必须与 OAuth 服务端登记的回调地址完全一致，包括端口和末尾 /。
# 浏览器访问地址也应使用 localhost，避免与 127.0.0.1 混用导致会话丢失。
OAUTH_CALLBACK_URL=http://localhost:8000/oauth/callback/
# Offer 确认链接的站点根地址；上线时填写收件人可访问的 HTTPS 地址。
OFFER_CONFIRM_BASE_URL=http://localhost:8000

# CSRF
# 本地 HTTP 使用 false；上线并启用 HTTPS 后改为 true。
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=false
CSRF_USE_SESSIONS=true
# 必须包含协议，使用非默认端口时也需包含端口；不要填写路径。
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# 邮件（可选）
# 本地默认只将邮件打印到终端，不连接 SMTP，也不会实际发送邮件。
# 真实发信时将 EMAIL_BACKEND 改为 django.core.mail.backends.smtp.EmailBackend，
# 并填写下面的 SMTP 主机、账号和密码 / 授权码。
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
# 常见配置：587 + TLS（SSL=false, TLS=true）或 465 + SSL（SSL=true, TLS=false）。
# 以邮件服务商要求为准，SSL 和 TLS 不能同时为 true。
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# 真实发信时使用服务商允许的发件人地址。
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=no-reply@example.com
# SMTP 连接超时时间，单位为秒。
EMAIL_TIMEOUT=60

# 企业微信 / 飞书群机器人（可选，留空关闭）
# 填写机器人的完整 webhook URL；URL 中的 key / token 属于密钥。
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
# 额外的 webhook，多个地址用英文逗号分隔，根据域名识别企微或飞书。
NOTIFY_WEBHOOK_URLS=

# 申请通知格式：企微支持 card / markdown / text；飞书支持 card / text。
WECOM_NOTIFY_FORMAT=card
FEISHU_NOTIFY_FORMAT=card
# 通知卡片中 Logo 和审核页面的站点根地址，不带路径。
# 启用机器人前改为群成员可访问的 HTTPS 地址；localhost 仅用于本地预览。
NOTIFY_PUBLIC_BASE_URL=http://localhost:8000

# 上线前：替换全部占位值，设置 DJANGO_DEBUG=false、实际域名及 HTTPS 地址，
# 将 CSRF_COOKIE_SECURE 改为 true；需要真实邮件时切换 SMTP 后端并填写凭据。
