DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 开发期可用 DB_ENGINE=sqlite 快速起项目，无需安装 MySQL
# DB_ENGINE=sqlite
# DB_NAME=eid_db
DB_NAME=eid_db
DB_USER=eid_user
DB_PASSWORD=change_me
DB_HOST=127.0.0.1
DB_PORT=3306

# OIDC（Authorization Code + PKCE + RS256 ID Token）
# 端点默认值来自 OIDC Discovery，以下仅在需要覆盖默认值时设置
# OIDC_ISSUER=https://accountapi.emoera.com/api
# OIDC_AUTHORIZATION_ENDPOINT=https://account.emoera.com/api/oauth2/authorize
# OIDC_TOKEN_ENDPOINT=https://accountapi.emoera.com/api/oidc/token
# OIDC_USERINFO_ENDPOINT=https://accountapi.emoera.com/api/oidc/userinfo
# OIDC_JWKS_URI=https://accountapi.emoera.com/api/oidc/jwks
OIDC_SCOPES=openid profile email
OAUTH2_CLIENT_ID=change_me
OAUTH2_CLIENT_SECRET=change_me
OAUTH_CALLBACK_URL=http://localhost:8000/oauth/callback/
OFFER_CONFIRM_BASE_URL=http://localhost:8000

# 外部认证系统（trust）与邮件模板图片
TRUST_API_URL=https://trust.emoera.com
TRUST_SCHEME_ID=3
INTERVIEW_EMAIL_IMAGE_URL=https://eaccount.emoera.com/photos/bishitongzhi.png
OFFER_EMAIL_IMAGE_URL=https://eaccount.emoera.com/photos/welcome.png

CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTPONLY=false
CSRF_USE_SESSIONS=true
CSRF_TRUSTED_ORIGINS=http://localhost:8000

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_USE_TLS=true
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=change_me
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=no-reply@example.com
EMAIL_TIMEOUT=60

# Group robot webhooks (optional). Leave empty to disable.
# Never commit real webhook URLs or keys.
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
# Comma-separated extra webhooks; provider is inferred from the URL host.
NOTIFY_WEBHOOK_URLS=

# Application notifications: WeCom card | markdown | text; Feishu card | text.
WECOM_NOTIFY_FORMAT=card
FEISHU_NOTIFY_FORMAT=card
NOTIFY_PUBLIC_BASE_URL=https://neweid.emoera.com
